            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Dra. Julia Ramos\",\n  \"cpf\": \"66666666666\",\n  \"email\": \"julia.ramos@apiceodontologia.com.br\",\n  \"senha\": \"senha-segura\",\n  \"perfil\": \"DENTISTA\",\n  \"ativo\": true\n}"
        },
        "url": "{{baseUrl}}/usuarios"
      }
    },
    {
      "name": "Usuarios - Atualizar",
      "request": {
        "method": "PUT",
        "header": [
