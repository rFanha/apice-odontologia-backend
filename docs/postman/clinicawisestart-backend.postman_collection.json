{
  "info": {
    "name": "Clinica WiseStart - Backend",
    "description": "Colecao para testar manualmente a API do backend no Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": "1"
    },
    {
      "key": "pacienteId",
      "value": "1"
    },
    {
      "key": "dentistaId",
      "value": "1"
    },
    {
      "key": "especialidadeId",
      "value": "1"
    },
    {
      "key": "consultaId",
      "value": "1"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth - Login",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@apiceodontologia.com.br\",\n  \"senha\": \"Apice@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "if (json.token) { pm.collectionVariables.set('token', json.token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Usuarios - Listar",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/usuarios"
      }
    },
    {
      "name": "Usuarios - Buscar Por Id",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/usuarios/{{usuarioId}}"
      }
    },
    {
      "name": "Usuarios - Criar",
      "request": {
